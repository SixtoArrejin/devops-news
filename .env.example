# Variables de entorno para Docker Compose
# Copia este archivo como .env y configura tus valores

# Redis Configuration (opcional para Redis local)
REDIS_PASSWORD=
REDIS_USERNAME=default

# NewsAPI Configuration (obligatorio)
# Obtén tu clave gratuita en: https://newsapi.org/
NEWS_API_KEY=tu-newsapi-key-aqui

# Configuración adicional (opcional)
COMPOSE_PROJECT_NAME=devops-news